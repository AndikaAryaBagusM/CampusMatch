{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": [
      "src/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "next.config.ts",
      "postcss.config.mjs",
      "tsconfig.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "drainingSeconds": 60,
    "restartPolicyType": "ON_FAILURE",
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": { "numReplicas": 1 }
    }
  }
}
