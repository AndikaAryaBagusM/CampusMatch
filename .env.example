# Copy to .env.local and fill in. Never commit .env.local.

# --- Database ------------------------------------------------------------------

# Neon Postgres: use the connection strings of your Neon *dev* branch,
# never the main (production) branch.
# Pooled connection, used by the app.
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Must be "development" for `npm run db:smoke` to run. Guards against
# running the smoke test against production.
DB_ENV=development

# --- Auth.js -------------------------------------------------------------------

# Secret that signs Auth.js cookies and tokens. Use a different value per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Auth.js trusts the request host only with this set. Set it on Railway, and to
# run a production build locally (`next build && next start`); leave it unset
# for `npm run dev`.
# AUTH_TRUST_HOST=true

# The site's public origin. Required on Railway: behind `next start`,
# request.url says localhost:<port>, so without it OAuth callbacks and magic
# links point at localhost. On Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}.
# Leave it unset for `npm run dev`.
# AUTH_URL=https://campusmatch.up.railway.app

# Google login (Google Cloud Console > Credentials > OAuth client, type Web).
# Authorised redirect URI: <site>/api/auth/callback/google. Leave both empty to
# hide the Google button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic link through Resend. Leave AUTH_RESEND_KEY empty to hide email
# login. Until the sending domain is verified, onboarding@resend.dev only
# delivers to the Resend account owner's own address.
AUTH_RESEND_KEY=
# Sender of the magic-link email, from a domain verified in Resend.
AUTH_EMAIL_FROM=CampusMatch <onboarding@resend.dev>

# --- Ulasan and moderation -----------------------------------------------------

# Comma-separated emails of the Moderators (decisions.md 10d). They see
# /moderasi after signing in with one of these addresses. Case-insensitive.
MODERATOR_EMAILS=

# Address for Laporan and takedown requests, shown on the Ulasan form and the
# Laporkan page. Leave empty to hide the contact link.
KONTAK_EMAIL=

# Screening (ADR 0002): Claude API key used to classify each new or edited Ulasan.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-haiku-4-5-20251001.
# SCREENING_MODEL=

# The daily GitHub Actions cron (.github/workflows/cron-screening.yml) sends this
# as "Authorization: Bearer <CRON_SECRET>" to /api/cron/screening, which retries
# Screening for waiting Ulasan. Set the same value as a repo secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Secret key for HMAC-SHA256 of IPs (laporan.ip_hash and rate limits in batas_laju).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
