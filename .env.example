# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres: use the connection strings of your Neon *dev* branch,
# never the main (production) branch.
# Pooled connection, used by the app.
DATABASE_URL=
# Direct (unpooled) connection, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Must be "development" for `npm run db:smoke` to run. Guards against
# running the smoke test against production.
DB_ENV=development

# Secret key for HMAC-SHA256 of reporter IPs (laporan.ip_hash).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
